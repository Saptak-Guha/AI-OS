APP_NAME=AetherOS API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1

# Leave blank to run with the built-in structured fallback (no LLM calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=16000
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# Free local LLM (https://ollama.com). Used when no Anthropic key works.
# ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Optional Google OAuth (endpoints return 501 until both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Local default: SQLite, no Redis. Docker compose overrides both.
DATABASE_URL=sqlite+aiosqlite:///./data/aetheros.db
REDIS_URL=redis://localhost:6379/0
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173
